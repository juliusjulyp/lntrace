# Multi-stage build: compile lntrace CLN plugins on Debian Bookworm
# (same glibc as elementsproject/lightningd:v26.06.8)

FROM rust:1-bookworm AS builder

WORKDIR /build
COPY Cargo.toml Cargo.lock* ./
COPY crates/ crates/
COPY adapters/ adapters/

# Build both plugin binaries
RUN cargo build -p lntrace-cln --bin lntrace-cln-record --bin lntrace-cln --release

# Output: the two binaries in /plugins/
FROM debian:bookworm-slim
COPY --from=builder /build/target/release/lntrace-cln-record /plugins/lntrace-cln-record
COPY --from=builder /build/target/release/lntrace-cln /plugins/lntrace-cln
